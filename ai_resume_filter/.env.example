# Local/development environment template.
# Copy this file to `.env` for local runs, or use `.env.production.example` for production.

# Application identity and local server settings.
APP_NAME=TalentLens AI
VERSION=2.0.0
DEBUG=True
HOST=127.0.0.1
PORT=8000

# JWT signing secret. Replace this with a long random value before using any auth flows.
SECRET_KEY=

# Trusted hosts and CORS origins. Keep tight in production; wildcard is only acceptable for local dev.
ALLOWED_HOSTS=["localhost"]
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# When True the app will fail-fast on missing critical env vars. Set False for some test runners.
STRICT_STARTUP_CHECKS=True

# Existing persistence layer used by the app today.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=talentlens

# Optional relational database for the production stack.
DATABASE_URL=postgresql+psycopg2://talentlens:talentlens@localhost:5432/talentlens

# Vector database storage path used by ChromaDB.
CHROMA_PERSIST_DIRECTORY=./data/vector_db/chroma

# Model and vectorizer artifacts produced by training.
MODEL_PATH=./data/models/model.pkl
VECTORIZER_PATH=./data/models/vectorizer.pkl

# Upload, export, and cache directories. These should be writable at runtime.
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports
CACHE_DIR=./data/cache

# Maximum upload size in bytes (10 MB).
MAX_FILE_SIZE=10485760

# Allowed upload file extensions.
ALLOWED_EXTENSIONS=[".pdf", ".doc", ".docx", ".txt"]

# AI API keys. Leave blank if you want local heuristic behavior only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# CrewAI model provider settings (Gemini default)
# Supported providers in this app wrapper: gemini | openai | anthropic
CREWAI_PROVIDER=gemini
CREWAI_MODEL=gemini/gemini-1.5-flash
CREWAI_TASK_TIMEOUT=20
CREWAI_TEMPERATURE=0
CREWAI_PARALLEL=1

# Optional embedding model used by semantic search.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Disable Hugging Face dataset downloads when offline or when you only want local data.
SKIP_HF_DATASET=False

# Celery settings for async training and background processing.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1


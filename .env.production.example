# Production deployment template.
# Copy this file to `.env.production` and set real values before running Compose.

# Required application secret used for JWT signing and secure runtime behavior.
SECRET_KEY=replace-with-a-long-random-production-secret

# Public API URL used by the frontend in the browser.
NEXT_PUBLIC_API_URL=https://api.example.com

# Backend port exposed on the host.
BACKEND_PORT=8000

# Frontend port exposed on the host.
FRONTEND_PORT=3000

# Gunicorn worker count for the backend. Increase with CPU cores and traffic.
WEB_CONCURRENCY=2

# Gunicorn timeout in seconds for long-running requests.
GUNICORN_TIMEOUT=120

# Celery concurrency for background training jobs and async processing.
CELERY_CONCURRENCY=2

# Existing persistence layer used by the app today.
MONGODB_URL=mongodb://mongo:27017
MONGODB_DB=talentlens

# Production Postgres service. Kept available for relational features and reporting.
POSTGRES_DB=talentlens
POSTGRES_USER=talentlens
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql+psycopg2://talentlens:change-this-password@postgres:5432/talentlens

# Redis backs Celery and lightweight caching.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Runtime file locations inside the container.
MODEL_PATH=/app/data/models/model.pkl
VECTORIZER_PATH=/app/data/models/vectorizer.pkl
CHROMA_PERSIST_DIRECTORY=/app/data/vector_db/chroma
UPLOAD_DIR=/app/data/uploads
EXPORT_DIR=/app/data/exports
CACHE_DIR=/app/data/cache

# Keep dataset downloading disabled in production unless you explicitly want HF fetches.
SKIP_HF_DATASET=1
